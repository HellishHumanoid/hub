--[[
    OPF - Tool Grab + Conditional ServerHop (auto-requeue)
    ------------------------------------------------------
    Button 1 "Grab Tools":
        Grab all tools in Workspace. (No serverhop.)

    Button 2 "Hop Grab Tools":
        Grab all tools, then serverhop ONLY IF none of the target items
        (TARGET_KEYWORDS) are present. If a target is found, stay put.
        Auto-requeues on teleport so it keeps hopping server to server
        until it lands on a target (executor required for requeue).

    Both buttons: red = off, green = on.
]]

local Players          = game:GetService("Players")
local TeleportService  = game:GetService("TeleportService")
local UserInputService = game:GetService("UserInputService")

-- Wait for LocalPlayer to be ready (needed when script fires via queue_on_teleport)
local player = Players.LocalPlayer
if not player then
    Players:GetPropertyChangedSignal("LocalPlayer"):Wait()
    player = Players.LocalPlayer
end

local placeId = game.PlaceId

--==========================================================
-- Target list: if a Tool's name CONTAINS any of these
-- (case-insensitive), "Hop Grab Tools" will NOT hop.
--==========================================================
local TARGET_KEYWORDS = {
    "Compass", "Golden Compass", "Strange Compass",
    "Paw", "String", "Gravity", "Plasma", "Gum", "Ope",
    "Candy", "Chilly", "Flare", "Sand", "Magma", "Rumble",
    "Light", "Snow", "Gas", "Dark", "Buddha", "Quake", "Phoenix",
}

--==========================================================
-- Auto-requeue across hops (executor feature; no-op in Studio)
-- Grabs the script source and re-runs it on the next server.
--==========================================================
local queueFn = (syn and syn.queue_on_teleport)
    or (fluxus and fluxus.queue_on_teleport)
    or queue_on_teleport
    or (queueonteleport)

--==========================================================
-- GUI
--==========================================================
local screenGui = Instance.new("ScreenGui")
screenGui.Name           = "OPF_ToolGrabGui"
screenGui.ResetOnSpawn   = false
screenGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
screenGui.Parent         = player:WaitForChild("PlayerGui")

local frame = Instance.new("Frame")
frame.Name             = "Container"
frame.Size             = UDim2.new(0, 180, 0, 110)
frame.Position         = UDim2.new(0, 20, 0.5, -55)
frame.BackgroundColor3 = Color3.fromRGB(30, 30, 35)
frame.BorderSizePixel  = 0
frame.Active           = true
frame.Parent           = screenGui

local frameCorner = Instance.new("UICorner")
frameCorner.CornerRadius = UDim.new(0, 8)
frameCorner.Parent = frame

local function makeButton(name, text, yOffset)
    local b = Instance.new("TextButton")
    b.Name             = name
    b.Size             = UDim2.new(1, -20, 0, 40)
    b.Position         = UDim2.new(0, 10, 0, yOffset)
    b.BackgroundColor3 = Color3.fromRGB(220, 40, 40)  -- red = off
    b.Text             = text
    b.TextColor3       = Color3.fromRGB(255, 255, 255)
    b.TextSize         = 16
    b.Font             = Enum.Font.GothamBold
    b.AutoButtonColor  = false
    b.Parent           = frame

    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, 6)
    c.Parent = b
    return b
end

local grabButton    = makeButton("GrabToolsButton",    "Grab Tools",     10)
local hopGrabButton = makeButton("HopGrabToolsButton", "Hop Grab Tools", 60)

--==========================================================
-- Draggable frame
--==========================================================
do
    local dragging, dragStart, startPos
    frame.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            dragging  = true
            dragStart = input.Position
            startPos  = frame.Position
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    dragging = false
                end
            end)
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
        or input.UserInputType == Enum.UserInputType.Touch) then
            local delta = input.Position - dragStart
            frame.Position = UDim2.new(
                startPos.X.Scale, startPos.X.Offset + delta.X,
                startPos.Y.Scale, startPos.Y.Offset + delta.Y
            )
        end
    end)
end

--==========================================================
-- Helpers
--==========================================================
local function setOn(button, isOn)
    button.BackgroundColor3 = isOn
        and Color3.fromRGB(40, 220, 40)   -- green = on
        or  Color3.fromRGB(220, 40, 40)   -- red = off
end

-- IY-style grabtools: uses EquipTool and listens for new drops
local grabtoolsConn = nil

-- Returns true if obj is already inside any player's character or backpack
local function isOwnedByPlayer(obj)
    for _, p in ipairs(Players:GetPlayers()) do
        if p.Character and obj:IsDescendantOf(p.Character) then return true end
        local bp = p:FindFirstChild("Backpack")
        if bp and obj:IsDescendantOf(bp) then return true end
    end
    return false
end

local function tryGrab(tool, humanoid)
    if not (tool:IsA("Tool") and tool:FindFirstChild("Handle")) then return end
    if isOwnedByPlayer(tool) then return end
    -- Try EquipTool first; if it fails, parent directly to Backpack
    if not pcall(function() humanoid:EquipTool(tool) end) then
        pcall(function()
            local bp = player:FindFirstChild("Backpack")
            if bp then tool.Parent = bp end
        end)
    end
end

local function grabTools()
    -- Wait for character and Humanoid to be ready
    local char = player.Character or player.CharacterAdded:Wait()
    local humanoid = char:FindFirstChildWhichIsA("Humanoid")
        or char:WaitForChild("Humanoid", 10)
    if not humanoid then return end

    -- Search ALL descendants of workspace, not just direct children,
    -- so we catch tools nested inside folders/models (e.g. Blox Fruits)
    for _, obj in ipairs(workspace:GetDescendants()) do
        tryGrab(obj, humanoid)
    end

    -- Disconnect any previous listener
    if grabtoolsConn then grabtoolsConn:Disconnect() end

    -- Also grab anything that appears after we arrive
    grabtoolsConn = workspace.DescendantAdded:Connect(function(obj)
        local c = player.Character
        local h = c and c:FindFirstChildWhichIsA("Humanoid")
        if h then tryGrab(obj, h) end
    end)
end

local function stopGrabTools()
    if grabtoolsConn then
        grabtoolsConn:Disconnect()
        grabtoolsConn = nil
    end
end

-- Only checks the player's Backpack and equipped tool in Character.
-- Ignores items still sitting in workspace that we haven't actually picked up.
local function findTargetInInventory()
    local function checkName(name)
        local lname = string.lower(name)
        for _, kw in ipairs(TARGET_KEYWORDS) do
            if string.find(lname, string.lower(kw), 1, true) then
                return true, name
            end
        end
        return false
    end

    -- Check Backpack
    local backpack = player:FindFirstChild("Backpack")
    if backpack then
        for _, item in ipairs(backpack:GetChildren()) do
            if item:IsA("Tool") or item:IsA("BackpackItem") then
                local found, name = checkName(item.Name)
                if found then return true, name end
            end
        end
    end

    -- Check currently equipped tool (lives inside Character)
    local char = player.Character
    if char then
        for _, item in ipairs(char:GetChildren()) do
            if item:IsA("Tool") or item:IsA("BackpackItem") then
                local found, name = checkName(item.Name)
                if found then return true, name end
            end
        end
    end

    return false
end

-- Re-run this script on the next server before teleporting, if the
-- executor supports it. Falls back to the URL loader you paste below.
local function requeueSelf()
    if not queueFn then return end
    -- GitHub raw loader: re-fetches and runs the latest copy on each hop.
    -- Replace USER / REPO / BRANCH with your own.
    local payload = '_G.OPF_AUTORESUME = true; loadstring(game:HttpGet("https://raw.githubusercontent.com/HellishHumanoid/hub/refs/heads/main/opf"))()'
    pcall(function() queueFn(payload) end)
end

local function serverHop()
    requeueSelf()
    local ok, err = pcall(function()
        TeleportService:Teleport(placeId, player)
    end)
    if not ok then
        warn("[OPF] Teleport failed: " .. tostring(err))
    end
end

--==========================================================
-- Button 1: Grab Tools only
--==========================================================
local grabEnabled = false
grabButton.MouseButton1Click:Connect(function()
    grabEnabled = not grabEnabled
    setOn(grabButton, grabEnabled)
    if grabEnabled then
        grabTools()
    end
end)

--==========================================================
-- Button 2: Grab + hop unless a target is found (auto-requeues)
--==========================================================
local hopGrabEnabled = false

local function runHopGrab()
    grabTools()
    task.wait(2) -- brief wait for EquipTool to settle before checking inventory
    local found, name = findTargetInInventory()
    if found then
        stopGrabTools()
        hopGrabEnabled = false
        setOn(hopGrabButton, true)        -- leave green to show a hit
        hopGrabButton.Text = "Found: " .. name
        warn("[OPF] Target found in inventory (" .. name .. ") - not hopping.")
    else
        stopGrabTools()
        task.wait(3)
        serverHop()
    end
end

hopGrabButton.MouseButton1Click:Connect(function()
    hopGrabEnabled = not hopGrabEnabled
    setOn(hopGrabButton, hopGrabEnabled)
    if hopGrabEnabled then
        runHopGrab()
    end
end)

-- If we just arrived from a requeued hop, resume automatically.
if queueFn and _G.OPF_AUTORESUME then
    hopGrabEnabled = true
    setOn(hopGrabButton, true)
    task.spawn(runHopGrab)
end
_G.OPF_AUTORESUME = true
